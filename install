#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_root"

usage() {
  echo "Usage: ./install vMAJOR.MINOR.PATCH" >&2
}

if [[ $# -ne 1 || ! "$1" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  usage
  exit 64
fi

release_tag="$1"
compose=(sudo env "ARCUS_SIGNAL_IMAGE_TAG=$release_tag" docker compose --env-file .env)

echo "Pulling latest repo changes..."
git pull --ff-only

echo "Pulling Arcus Signal $release_tag image from GitHub..."
"${compose[@]}" pull api worker

echo "Starting database and queue dependencies..."
"${compose[@]}" up -d postgres redis

echo "Running database migrations..."
"${compose[@]}" run --rm api ./Run migrate --env development --yes

echo "Verifying packaged wgrib2 binary..."
"${compose[@]}" run --rm api test -x /usr/local/bin/wgrib2

echo "Starting api/worker from pulled images..."
"${compose[@]}" up -d --no-build api worker

echo "Done."
